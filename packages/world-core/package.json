{
  "name": "@hubitat/world-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "echo 'lint: not configured yet'"
  },
  "dependencies": {
    "@hubitat/protocol": "*"
  },
  "devDependencies": {
    "@hubitat/config": "*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
