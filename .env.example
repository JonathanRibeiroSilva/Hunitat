# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and adjust. Every value read anywhere in the system appears here.
# Defaults come from specs/conventions/tuning-defaults.md — changing any of them
# must never require a rebuild (NFR-39).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Ports ────────────────────────────────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173

# ── Client → server ──────────────────────────────────────────────────────────
# Used by apps/web at build time (Vite inlines VITE_* vars).
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# First used in phase 5, for `messages` and `read_state` (ADR 0008). Nothing
# about presence or movement touches it — FR-1.7 requires guest identity to be
# ephemeral, and it still is.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hubitat
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=hubitat

# ── Realtime & replication (phase 1) ─────────────────────────────────────────
TICK_RATE_HZ=20
CLIENT_SEND_RATE_HZ=20
INTERPOLATION_BUFFER_MS=100
# Enter and exit radii are a PAIR. Setting them equal reintroduces the boundary
# flapping FR-1.17 forbids.
AOI_ENTER_RADIUS_M=25
AOI_EXIT_RADIUS_M=30
AOI_CELL_SIZE_M=25
PING_INTERVAL_MS=10000
# Must STRICTLY exceed 2 x PING_INTERVAL_MS, or one dropped pong evicts a healthy
# session. The api validates this at boot and refuses to start otherwise.
STALE_SESSION_TIMEOUT_MS=30000
IDLE_TIMEOUT_MS=60000
RESUME_TOKEN_TTL_MS=60000
MAX_BUFFERED_BYTES=65536

# ── Movement (phases 1, 4) ───────────────────────────────────────────────────
WALK_SPEED_MPS=3.0
RUN_SPEED_MPS=6.0
ACCELERATION_MPS2=25.0
JUMP_HEIGHT_M=0.9
GRAVITY_MPS2=-9.81
CHARACTER_STEP_OFFSET_M=0.35
CHARACTER_SLOPE_LIMIT_DEG=45
CHARACTER_SNAP_TO_GROUND_M=0.2

# ── Limits & safety (all phases) ─────────────────────────────────────────────
MAX_MESSAGE_BYTES=4096
MAX_INBOUND_MSGS_PER_SEC=60
MAX_DISPLAY_NAME_CHARS=32
WS_HANDSHAKE_TIMEOUT_MS=10000

# ── World (phase 1) ──────────────────────────────────────────────────────────
WORLD_MAP_ID=office
WORLD_ASSET_BASE_URL=/assets/world
# Where the repository's assets/ directory lives. Defaults to ../../assets from
# the api's working directory; the container image sets /repo/assets.
# ASSETS_DIR=

# ── Avatars (phase 4) ────────────────────────────────────────────────────────
AVATAR_ASSET_BASE_URL=/assets/avatars
AVATAR_MODEL_ID=avatar

# EMOTE_MIN_INTERVAL_MS is the anti-spam guarantee and is enforced on the
# SERVER. Excess is dropped silently, never answered with an error. The client
# greys out its emote bar from the same number, which is a courtesy — an
# anti-spam rule that lives in the client is not a rule.
EMOTE_MIN_INTERVAL_MS=2000
# The ceiling every emote's authored duration is clamped to, so no gesture can
# be made to run forever. Must be positive; refused at boot.
EMOTE_MAX_DURATION_MS=5000

ANIMATION_CROSSFADE_MS=200
# Must sit strictly between 0 and RUN_SPEED_MPS, or one of the locomotion states
# can never be reached. Refused at boot.
RUN_ANIMATION_THRESHOLD_MPS=4.0

# Nameplates fade from the first and are gone past the second. HIDE must exceed
# FADE_START — equal or inverted makes them vanish instead of fading, which
# reads as a rendering bug. Refused at boot.
NAMEPLATE_FADE_START_M=15
NAMEPLATE_HIDE_M=25

# ── Zones and audience (phase 3) ─────────────────────────────────────────────
# ZONE_HYSTERESIS_M is the gap between the enter and exit tests. Negative is
# refused at boot: it inverts the test and makes zone membership flap on edges.
ZONE_HYSTERESIS_M=0.3
PORTAL_COOLDOWN_MS=1500
PORTAL_EXIT_CLEARANCE_M=1.5
SPOTLIGHT_GAIN=1.0
PRIVATE_ZONE_GAIN=1.0

# ── Spatial media (phase 2) ──────────────────────────────────────────────────
# These set the `gain` in every AUDIENCE frame the server sends, and the same
# numbers configure the browser's PannerNode — the server's advertised gain and
# what a listener actually hears come from one place (ADR 0007).
#
# MAX_AUDIBLE_DISTANCE_M must stay below AOI_ENTER_RADIUS_M, or someone can
# become audible before they have ever been announced as present. Refused at boot.
MAX_AUDIBLE_DISTANCE_M=12
MAX_VISIBLE_DISTANCE_M=8
AUDIO_REF_DISTANCE_M=1.0
AUDIO_ROLLOFF_FACTOR=1.2

# The band that stops media subscriptions thrashing at a range boundary. Same
# mechanism as AOI's two radii and ZONE_HYSTERESIS_M; at zero, standing on the
# threshold renegotiates a WebRTC track twenty times a second.
AUDIO_HYSTERESIS_M=2

# Per-client stream ceilings (NFR-20). When more are in range than fit, video is
# shed before audio, most distant first — audio is never dropped for video.
MAX_CONCURRENT_AUDIO=12
MAX_CONCURRENT_VIDEO=6

# ── Phase 2 : LiveKit SFU ────────────────────────────────────────────────────
# Leave ALL THREE empty to run without voice and video — the world, movement and
# presence work unchanged, and the media controls render as unavailable. Setting
# some but not all is refused at boot: partial credentials look configured and
# reject every token, and the symptom is "nobody can hear anyone".
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-chars
# The address handed to BROWSERS, when it differs from the one the server uses.
# Compose sets it: there the server reaches the SFU at ws://livekit:7880, a name
# no browser can resolve. Defaults to LIVEKIT_URL, which is right when both
# reach the SFU the same way. Behind TLS this is wss://livekit.your-host.
# LIVEKIT_PUBLIC_URL=
# One World Instance = one Room. Defaults to world-$WORLD_MAP_ID.
# LIVEKIT_ROOM=
LIVEKIT_TOKEN_TTL_SECONDS=21600

# ── Chat (phase 5) ───────────────────────────────────────────────────────────
# CHAT_NEARBY_RADIUS_M defaults to MAX_AUDIBLE_DISTANCE_M and should track it:
# the Phase 5 rule is that "people I can talk to" matches "people my local chat
# reaches". Setting it to a different value is allowed and logs a warning at
# boot — diverging them deliberately is a decision, by accident it is a bug.
# Must stay below AOI_ENTER_RADIUS_M, or a message can arrive from somebody the
# recipient has never been told is present. Refused at boot.
# CHAT_NEARBY_RADIUS_M=12
CHAT_MAX_MESSAGE_CHARS=2000

# FR-5.11/FR-5.12 — how much history a persistent channel keeps, and for how
# long. Only `room` and `direct` are stored at all; `nearby` and `zone` are
# delivered and forgotten, which is a guarantee rather than a setting.
CHAT_HISTORY_LIMIT=200
CHAT_HISTORY_RETENTION_DAYS=90

# How long a typing indicator survives without a refresh. The receiving client
# is told this number rather than reading its own copy, so an indicator clears
# even when the "stopped" frame is lost — which is what happens when somebody
# closes the tab mid-sentence.
TYPING_INDICATOR_TTL_MS=5000

# Enforced on the SERVER, like every other anti-spam rule here. Separate from
# MAX_INBOUND_MSGS_PER_SEC because that one protects the socket and this one
# protects the room.
CHAT_RATE_LIMIT_PER_MIN=30

# Where room and direct history lives.
#   auto     (default) use PostgreSQL when it answers, fall back to memory with
#            a warning when it does not. Keeps development working with no
#            Docker running.
#   postgres require it — refuse to boot otherwise. Use this in production:
#            silently degrading a durable channel to one that empties on restart
#            is the failure nobody notices until they go looking for a
#            conversation.
#   memory   never connect. History lives and dies with the process.
# GET /health reports which one is in use.
CHAT_PERSISTENCE=auto

# ── Accounts, identity and membership (phase 6) ──────────────────────────────
#
# Whether accounts exist at all. Shaped like CHAT_PERSISTENCE, because it answers
# the same question about the same connection:
#   auto      accounts when a database is reachable, guests only when not. The
#             default, and what keeps the no-Docker development flow working.
#   required  refuse to boot without a database. The production setting: a
#             deployment that meant to require accounts and silently admits
#             everyone as a guest is FR-6.8 inverted.
#   off       never open a connection for accounts.
ACCOUNTS=auto

# Signs every access token. Leave it empty and one is generated at boot, which is
# right for `npm run dev` and wrong for anything else: every signed token becomes
# invalid on restart and everybody is signed out. At least 32 characters — a
# short one can be recovered offline from a single captured token.
AUTH_JWT_SECRET=

# FR-6.17. The access token is a bearer credential with no revocation list, so
# its lifetime IS the revocation window. The refresh token is rotated on every
# use, so its TTL is how long inactivity is tolerated.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# FR-6.3. A length floor and nothing else — NIST 800-63B has recommended against
# character-class rules since 2017, because they buy `Password1!`.
PASSWORD_MIN_LENGTH=12

# The OWASP argon2id floor (ADR 0011). The server REFUSES TO START below any of
# them: lowering these makes logins faster and an offline attack against a stolen
# table cheaper, and nothing in the running system ever mentions it.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# FR-6.14 — applied when an invite is created without an explicit expiry. Every
# invite is bounded in time even when its use count is not, because an
# unlimited-use link with no expiry is a permanent unrevoked door.
INVITE_DEFAULT_TTL_HOURS=168
# FR-6.5 — a reset link is a password equivalent sitting in an inbox.
RESET_TOKEN_TTL_MIN=30

# The refresh cookie. `auto` sets `Secure` when the request arrived over TLS,
# which is the only answer that is right everywhere: always-on silently drops the
# cookie on plain HTTP against a LAN address (sign-in appears to work, the first
# refresh 401s), always-off puts a bearer credential on the wire in cleartext.
#
# SameSite=Lax is correct while the client and the api share a registrable domain
# — including localhost:5173 -> localhost:3000, which is same-SITE despite being
# cross-origin. Genuinely different domains need `none`, which forces Secure.
AUTH_COOKIE_SECURE=auto
AUTH_COOKIE_SAMESITE=lax

# DC-8.1 — the single Space this world instance belongs to. Phase 8 makes this a
# table with more than one row in it.
#
# SPACE_ALLOW_GUESTS only SEEDS the row (FR-6.8). Once it exists the database is
# authoritative, so an operator who closes the space through the account panel
# does not find it reopened by the next restart.
SPACE_SLUG=default
SPACE_NAME=hubitat
SPACE_ALLOW_GUESTS=true

# Where invite and reset links point. Empty derives it from the request, which is
# what makes links work behind a tunnel or a proxy whose public name nobody knew
# at boot.
PUBLIC_WEB_URL=

# ── Permissions, moderation and capacity (phase 7) ───────────────────────────
#
# ONE VARIABLE, AND THAT IS THE POINT. Everything else phase 7 introduces is
# STATE, not configuration: whether a space is locked, what its password is, who
# is on its allowlist, who is banned, who is an admin. All of it is set from the
# moderation panel and lives in the database, because a policy an operator can
# change from inside the world must not be silently reverted by the next restart
# — the same reasoning SPACE_ALLOW_GUESTS above is written for, applied to five
# more settings (FR-7.11 to FR-7.15).
#
# There is deliberately no SPACE_ACCESS_PASSWORD. A password in an environment
# file is a password in a deploy log, a shell history and a backup, and the one
# here is typed by everybody who enters — so it is set through the API, hashed
# with argon2id like every other password in this product, and never read back.
#
# FR-7.14 — how many participants one map admits when a Space has not set its own
# ceiling. 50 is the figure NFR-1 was designed and verified against; above it the
# server WARNS (watch lastTickMs on /health) and below 2 it REFUSES TO START,
# because a world nobody can ever be joined in is not a capacity limit.
#
# From phase 8 this is the *default* and the fallback of three levels: a Map's
# own capacity, then the Space's, then this. Exceeding it no longer only refuses
# — a Map set to `instance` spills into another copy of itself (FR-8.8), and one
# set to `refuse` still says it is full, which is right for a room whose whole
# point is that everybody in it is together.
DEFAULT_MAP_CAPACITY=50

# ── Object storage — the asset library (phase 9, FR-9.11) ────────────────────
#
# Needed only to UPLOAD assets. The built-in library ships in the repository and
# is served statically, so a map can be authored with no object storage at all
# (FR-9.15) — leave MINIO_ENDPOINT empty and uploads say they are unavailable
# rather than failing mysteriously.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=hubitat
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_BUCKET=assets
MINIO_USE_SSL=false

# TWO ADDRESSES FOR ONE BUCKET, exactly as LIVEKIT has two.
#
# The api reaches MinIO at MINIO_ENDPOINT; the BROWSER follows presigned URLs the
# api signs. Under Compose those are different hosts — `minio:9000` resolves only
# inside the Docker network — and a presigned URL carries its host inside the
# signature, so it cannot be rewritten afterwards. Sign against the wrong one and
# every asset fails to load with a DNS error nobody connects to this setting.
#
# Defaults to the server's own address, which is correct on bare metal.
MINIO_PUBLIC_URL=http://localhost:9000

# How long a presigned upload or download URL is valid. Short: an upload URL is
# write access to a bucket, and a download URL is re-issued on every read anyway.
ASSET_URL_TTL_SECONDS=900

# FR-9.13 — whether uploads are queued for optimization.
#
#   auto  queue when there is a database to queue into; without the `worker`
#         container the job simply waits, and an upload is usable as it arrived.
#   off   never queue. An uploaded model is used exactly as uploaded, with no
#         level-of-detail variants — honest, and what a machine with no worker
#         has anyway.
ASSET_PIPELINE=auto

# ── SMTP — password recovery (phase 6, FR-6.5) ───────────────────────────────
#
# THE ONLY OUTBOUND NETWORK DEPENDENCY IN THE PRODUCT, AND IT IS OPTIONAL
# (ADR 0011). Leave SMTP_HOST empty to disable recovery entirely: the client is
# told so and never shows a "Forgot your password?" link that does nothing, and
# an operator resets passwords administratively. The system then runs on an
# air-gapped network with nothing else lost.
#
# SMTP_HOST set with SMTP_FROM empty is refused at boot — a relay accepts the
# connection and rejects every message, which presents as recovery being broken
# rather than misconfigured. Compose runs Mailpit on 1025, inbox at :8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=noreply@hubitat.local

# ── Harness (apps/harness) ───────────────────────────────────────────────────
HARNESS_WS_URL=ws://localhost:3000/ws
HARNESS_BOT_COUNT=50
