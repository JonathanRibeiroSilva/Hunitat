    "@gltf-transform/functions": "^4.1.1",
    "@hubitat/protocol": "*",
    "meshoptimizer": "^0.22.0",
    "pg": "^8.22.0",
    "pg-boss": "^10.1.5"
  },
  "devDependencies": {
    "@hubitat/config": "*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
